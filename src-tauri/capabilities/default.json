{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Janela principal",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "allow-get-state",
    "allow-create-community",
    "allow-join-community",
    "allow-switch-community",
    "allow-send-chat",
    "allow-leave-community",
    "allow-add-room",
    "allow-join-call",
    "allow-leave-call",
    "allow-send-signal",
    "allow-rtc-start",
    "allow-rtc-stop",
    "allow-rtc-sync",
    "allow-rtc-signal",
    "allow-rtc-push-frame",
    "allow-save-profile",
    "allow-publish-presence",
    "allow-get-history",
    "allow-append-call-log"
  ]
}
